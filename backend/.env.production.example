# === Variaveis de Producao - Backend (EXEMPLO) ===
# NUNCA commitar secrets reais.
#
# O dominio e controlado pela variavel APP_URL no .env.production da raiz.
# Para alterar o dominio, mude APP_URL — nenhum codigo precisa ser alterado.
#
DEBUG=False
SECRET_KEY=change-this-to-a-64-char-random-string
ALLOWED_HOSTS=.insights-software.dev.br,localhost
DB_NAME=whatsapp_service
DB_USER=whatsapp_user
DB_PASSWORD=change-this-to-a-secure-password
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
FRONTEND_URL=https://sos-whats-atendimento.insights-software.dev.br
CORS_ALLOWED_ORIGINS=https://sos-whats-atendimento.insights-software.dev.br
CSRF_TRUSTED_ORIGINS=https://sos-whats-atendimento.insights-software.dev.br
EVOLUTION_WEBHOOK_BASE_URL=https://sos-whats-atendimento.insights-software.dev.br
EVOLUTION_API_KEY=change-this-to-a-secure-key
