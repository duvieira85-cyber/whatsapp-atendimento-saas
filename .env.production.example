# =============================================================================
# WhatsApp Atendimento SaaS — Variaveis de Producao (EXEMPLO)
# =============================================================================
# Copie este arquivo para .env.production e preencha com valores reais.
# NUNCA commitar .env.production com secrets reais.
# =============================================================================
# Todas as referencias de dominio sao feitas via APP_URL.
# Para mudar o dominio, altere apenas APP_URL e as variaveis derivadas.
# Nenhum codigo-fonte precisa ser alterado.
# =============================================================================

# --- Dominio principal ---
APP_URL=https://sos-whats-atendimento.insights-software.dev.br
DOMAIN=sos-whats-atendimento.insights-software.dev.br

# --- URLs derivadas (calculadas a partir de APP_URL) ---
FRONTEND_URL=${APP_URL}
API_URL=${APP_URL}/api
WS_URL=wss://${DOMAIN}/ws

# --- Backend ---
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_PORT=5173

# --- Banco de Dados (PostgreSQL) ---
DB_NAME=whatsapp_service
DB_USER=whatsapp_user
DB_PASSWORD=change-this-to-a-secure-password
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Evolution API ---
EVOLUTION_PORT=8081
EVOLUTION_API_KEY=change-this-to-a-secure-key

# --- Nginx ---
NGINX_PORT=8080
NGINX_SSL_PORT=8443

# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-64-char-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.insights-software.dev.br,localhost
DJANGO_CORS_ALLOWED_ORIGINS=${APP_URL}
DJANGO_CSRF_TRUSTED_ORIGINS=${APP_URL}
